# ── Required ────────────────────────────────────────────────────────────────
# Your Groq API key from https://console.groq.com (the app's only secret in dev)
GROQ_API_KEY=

# ── Models (defaults shown; override if Groq deprecates an ID) ──────────────
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.3-70b-versatile

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3001
INTERVIEWER_NAME=Asha
TOTAL_QUESTIONS=8

# ── Storage ──────────────────────────────────────────────────────────────────
# "file" (default, zero setup) or "supabase" (production)
STORAGE_BACKEND=file
# Only needed when STORAGE_BACKEND=supabase:
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Admin peek (optional) ────────────────────────────────────────────────────
# Set to any long random string to enable GET /api/admin/stats?key=...
ADMIN_KEY=
